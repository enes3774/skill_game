# Server
NODE_ENV=development
PORT=3001
WS_PORT=3002

# Privy Authentication
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
GAME_WALLET_ADDRESS=your_game_wallet_public_key
GAME_WALLET_PRIVATE_KEY_ENCRYPTED=base64_encrypted_private_key
WALLET_ENCRYPTION_PASSWORD=your_secure_encryption_password

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agario_betting
DB_SSL=false

# Security
JWT_SECRET=your_jwt_secret_key_here
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=60

# Game Settings
MAX_PLAYERS_PER_ROOM=50
TICK_RATE=60
RAKE_PERCENTAGE=0.10
MIN_WITHDRAWAL_AMOUNT=0.01
MAX_DAILY_WITHDRAWAL=10.0

# Betting Tiers
TIER_BRONZE_BUYIN=0.05
TIER_SILVER_BUYIN=0.25
TIER_GOLD_BUYIN=1.0

# Monitoring (optional)
SENTRY_DSN=
DATADOG_API_KEY=
